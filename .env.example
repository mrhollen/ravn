# ravn — environment template (slice 6).
#
# Copy to `.env` next to docker-compose.yml and edit as needed:
#   cp .env.example .env
# `docker compose` interpolates every ${VAR:-default} below from this file
# automatically — and since each variable has a default, an empty (or missing)
# .env is fully valid. Never commit the real .env (it is gitignored).

# Bearer token protecting /api/v1/*. Optional.
# AUTH IS OFF BY DEFAULT for single-tenant local use: leave empty for a
# trust-your-LAN setup, or set a value and send `Authorization: Bearer <token>`
# on API calls (the MCP container forwards this to the server automatically).
RAVN_TOKEN=

# Actor name stamped on MCP tool calls when the model omits an explicit actor.
# Claims key on this name, so use something identifiable per agent if you run
# several against one stack. Default: agent
RAVN_AGENT_NAME=agent

# Container image used by docker compose. Defaults to a locally-built `ravn:latest`
# (docker-compose.yml builds it when the image is absent). Point it at your own
# registry image if needed, e.g. ghcr.io/<you>/ravn:latest or <registry>/<you>/ravn:latest.
RAVN_IMAGE=ravn:latest

# Host-side bind IP and port overrides.
# Default binding is 127.0.0.1 (loopback) to prevent exposing unauthenticated
# instances to the LAN or public internet when RAVN_TOKEN is empty.
#
# WARNING: If you set RAVN_BIND_IP to 0.0.0.0 or a LAN interface (e.g. 192.168.1.x),
# YOU MUST configure RAVN_TOKEN above to prevent unrestricted, unauthenticated
# access to your database, REST API, web board, and autonomous OpenCode execution.
#
# Containers ALWAYS listen on 8080 (server) and 9080 (MCP) internally — only the
# published host mapping changes, which keeps the MCP→server upstream URL stable.
# Raise ports if another process already owns the default host ports, e.g.:
#   RAVN_SERVER_PORT=18080
RAVN_BIND_IP=127.0.0.1
RAVN_SERVER_PORT=3311
RAVN_MCP_PORT=9311

# Default model for autonomous OpenCode sessions (format: providerID/modelID).
# Optional; empty = use the OpenCode server's default model.
OPENCODE_MODEL=

# OpenCode server base URL forwarded to ravn-server (empty = built-in default,
# http://localhost:4444). Set e.g. http://<host>:<port>.
OPENCODE_SERVER_URL=

# Working directory for autonomous OpenCode sessions, forwarded to ravn-server.
# Empty = built-in default; when set it must be an absolute path on the host running the server.
OPENCODE_DIRECTORY=

# Allow OpenCode server URLs targeting LAN/private network addresses (10.x.x.x, 172.16-31.x.x, 192.168.x.x, localhost).
# Defaults to true in docker-compose. Set to false to enforce strict public-only egress.
OPENCODE_ALLOW_PRIVATE_IPS=true

# Optional explicit allowlist of OpenCode hostnames, IPs, or CIDR blocks (comma-separated).
# E.g. OPENCODE_ALLOWED_HOSTS=<ip>,<ip>:4444 or OPENCODE_ALLOWED_HOSTS=*
OPENCODE_ALLOWED_HOSTS=

# Persistent storage directories / volume overrides (optional).
# Defaults to named Docker volumes ('ravn-data' and 'ravn-artifacts').
# To mount local host directories instead (e.g. for direct access to SQLite db and artifacts),
# uncomment or set these variables:
# RAVN_DATA_DIR=./data
# RAVN_ARTIFACTS_DIR=./artifacts
#
# NOTE: ravn-server runs as unprivileged UID 10001 inside the container.
# If using host bind mounts, ensure the host directories exist and are writable
# by UID 10001 (e.g. `mkdir -p data artifacts && chown -R 10001:10001 data artifacts`
# or `chmod 777 data artifacts`).
