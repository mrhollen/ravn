# crowban — environment template (slice 6).
#
# Copy to `.env` next to docker-compose.yml and edit as needed:
#   cp .env.example .env
# `docker compose` interpolates every ${VAR:-default} below from this file
# automatically — and since each variable has a default, an empty (or missing)
# .env is fully valid. Never commit the real .env (it is gitignored).

# Bearer token protecting /api/v1/*. Optional.
# AUTH IS OFF BY DEFAULT for single-tenant local use: leave empty for a
# trust-your-LAN setup, or set a value and send `Authorization: Bearer <token>`
# on API calls (the MCP container forwards this to the server automatically).
CROWBAN_TOKEN=

# Actor name stamped on MCP tool calls when the model omits an explicit actor.
# Claims key on this name, so use something identifiable per agent if you run
# several against one stack. Default: agent
CROWBAN_AGENT_NAME=agent

# Host-side port overrides. Containers ALWAYS listen on 8080 (server) and
# 9080 (MCP) internally — only the published host mapping changes, which keeps
# the MCP→server upstream URL (http://crowban-server:8080) stable.
# Raise these if another process already owns the default host ports, e.g.:
#   CROWBAN_SERVER_PORT=18080
CROWBAN_SERVER_PORT=3311
CROWBAN_MCP_PORT=9311
