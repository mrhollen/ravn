# syntax=docker/dockerfile:1
#
# crowban-mcp — standalone build for classic (non-BuildKit) docker-compose,
# which cannot select a stage via build.target. Derived from the shared
# multi-stage Dockerfile (go-build + mcp-runtime); keep the two in sync when
# build stages change.

FROM golang:1.25-alpine AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/crowban-mcp ./cmd/crowban-mcp

FROM alpine:3.21
RUN addgroup -g 10001 app \
 && adduser -D -u 10001 -G app app
COPY --from=go-build /out/crowban-mcp /usr/local/bin/
USER app
ENV MCP_ADDR=:9080 \
    CROWBAN_API_URL=http://crowban-server:8080
EXPOSE 9080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:9080/healthz || exit 1
ENTRYPOINT ["crowban-mcp"]
