# syntax=docker/dockerfile:1
#
# crowban-server — standalone build for classic (non-BuildKit) docker-compose,
# which cannot select a stage via build.target. Derived from the shared
# multi-stage Dockerfile (web-build + go-build + server-runtime); keep the
# two in sync when build stages change.

FROM node:22-alpine AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.25-alpine AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/crowban-server ./cmd/crowban-server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
 && addgroup -g 10001 app \
 && adduser -D -u 10001 -G app app \
 && mkdir -p /data \
 && chown app:app /data
COPY --from=go-build  /out/crowban-server /usr/local/bin/
COPY --from=web-build /web/dist           /app/public
USER app
ENV CROWBAN_ADDR=:8080 \
    CROWBAN_DATA=/data/crowban.db \
    CROWBAN_STATIC_DIR=/app/public
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["crowban-server"]
