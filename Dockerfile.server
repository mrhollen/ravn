# syntax=docker/dockerfile:1
#
# ravn-server — standalone build for classic (non-BuildKit) docker-compose,
# which cannot select a stage via build.target. Derived from the shared
# multi-stage Dockerfile (web-build + go-build + server-runtime); keep the
# two in sync when build stages change.

# Base images pinned to immutable digests (same pins as Dockerfile — keep in
# sync; verified resolvable against registry-1.docker.io on 2026-11-08). To bump
# one image, re-resolve the tag's manifest digest and edit exactly one FROM line.

FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS web-build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.25.14-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS go-build
WORKDIR /src
# Module files first so the `go mod download` layer stays cached across source edits.
COPY go.mod go.sum ./
RUN go mod download
# Go-only context (NOT `COPY . .`): web/ is excluded so UI edits never invalidate
# this stage. Copy exactly the top-level dirs containing .go sources: cmd/ and
# internal/ (internal/infrastructure/sqlite also carries //go:embed migrations/*.sql).
COPY cmd/ ./cmd/
COPY internal/ ./internal/
ARG VERSION=dev
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/ravn-server ./cmd/ravn-server && \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/ravn-mcp    ./cmd/ravn-mcp

FROM alpine:3.21.10@sha256:769c0a0cb2a64409697b54551072ee46ee1e36d4b369ddafd671b02a5d16e0e5
RUN apk add --no-cache ca-certificates \
 && addgroup -g 10001 app \
 && adduser -D -u 10001 -G app app \
 && mkdir -p /data /artifacts \
 && chown app:app /data /artifacts
COPY --from=go-build  /out/ravn-server /usr/local/bin/
COPY --from=go-build  /out/ravn-mcp    /usr/local/bin/
COPY --from=web-build /web/dist           /app/public
USER app
ENV RAVN_ADDR=:8080 \
    RAVN_DATA=/data/ravn.db \
    RAVN_STATIC_DIR=/app/public \
    RAVN_ARTIFACTS_DIR=/artifacts
VOLUME ["/data", "/artifacts"]
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["ravn-server"]
